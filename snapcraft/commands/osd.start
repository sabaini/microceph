#!/bin/bash
set -eu

# shellcheck disable=SC2155
export SNAP_CURRENT="$(realpath "${SNAP_DATA}/..")/current"
echo $$ > "${SNAP_CURRENT}/run/ceph-osd.pid"
cd "${SNAP}"

. "${SNAP}/commands/common"

limits

is_osd_running() {
    osdid="${1:?missing}"

    skt="${SNAP_CURRENT}/run/ceph-osd.${osdid}.asok"

    nc -z -U "${skt}" >/dev/null 2>&1
}

# OSDs are croit-flashstore-osd (croit ceph-rust), one per NVMe namespace.
# The daemon stays in the foreground, so each OSD runs as a background job of
# this service. `--id` goes last: microcephd finds the process of an OSD by it.
start_osd() {
    nr="${1:?missing}"

    args=(run --cluster ceph --set log_to_file=true --set log_to_stderr=false)
    cores="$(snapctl get flashstore.cores)"
    if [ -n "${cores}" ]; then
        args+=(--cores "${cores}")
    fi

    croit-flashstore-osd "${args[@]}" -f --id "${nr}" &
    pid=$!

    # Up once the admin socket answers; a start that fails exits before that.
    for _ in $(seq 1 120); do
        is_osd_running "${nr}" && return 0
        if ! kill -0 "${pid}" 2>/dev/null; then
            wait "${pid}" || true
            return 1
        fi
        sleep 0.5
    done
    # Still mounting its store (long WAL replay): leave it to finish.
    return 0
}

spawn() {
    retry_pending=false
    for i in "${SNAP_COMMON}/data/osd"/*; do
        filename="$(basename "${i}")"
        [ -z "$filename" ] && continue

        nr="${filename##ceph-}"
        [ -z "$nr" ] && continue

        [ ! -e "${i}/ready" ] && continue

        # Not prepared by croit-flashstore-tool, e.g. a BlueStore OSD of a
        # classic MicroCeph: this snap ships no ceph-osd to run it.
        if [ ! -e "${i}/croit-flashstore-osd" ]; then
            echo "osd.${nr} is not a FlashStore OSD; skipping" >&2
            continue
        fi

        is_osd_running "${nr}" && continue

        # Start the OSD but tolerate per-OSD failure: a single OSD that
        # cannot start (e.g. its backing block device was removed without
        # purging the OSD first) must not abort the loop under `set -e`,
        # otherwise every later OSD on the node is stranded and the service
        # enters an endless restart loop. See issue #521.
        if ! start_osd "${nr}"; then
            echo "osd.${nr} failed to start; will retry" >&2
            retry_pending=true
            continue
        fi
    done

}

# Retry failed starts without restarting healthy OSDs or blocking later OSDs.
# Once all starts succeed, retain the existing reload-driven idle behaviour.
timer_pid=""
reload_requested=false
request_reload() {
    reload_requested=true
    if [ -n "$timer_pid" ]; then
        kill "$timer_pid" 2>/dev/null || true
    fi
}
trap request_reload HUP

wait_for_config

while true; do
    reload_requested=false
    spawn
    "$reload_requested" && continue

    delay=infinity
    if "$retry_pending"; then
        delay=5
    fi
    sleep "$delay" &
    timer_pid=$!
    # Also handle a reload received between spawn and registering the timer.
    if "$reload_requested"; then
        kill "$timer_pid" 2>/dev/null || true
    fi
    wait "$timer_pid" || true
    timer_pid=""
done
