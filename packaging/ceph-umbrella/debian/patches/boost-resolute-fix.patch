Description: Fix FTBFS due to Boost deprecations
Subject: Boost 1.90 deprecated several features that
  Ceph makes use of, among them in the AIO and process
  libraries. This patchset updates the source so that
  it uses the updated implementations.
Author: Luciano Lo Giudice <luciano.logiudice@canonical.com>
Forwarded: not-needed

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -764,7 +764,7 @@ option(WITH_SYSTEM_BOOST "require and bu
 # Boost::thread depends on Boost::atomic, so list it explicitly.
 set(BOOST_COMPONENTS
   atomic chrono headers thread regex random program_options date_time
-  iostreams context coroutine url)
+  iostreams context coroutine url process)
 set(BOOST_HEADER_COMPONENTS container)
 
 if(WITH_MGR)
